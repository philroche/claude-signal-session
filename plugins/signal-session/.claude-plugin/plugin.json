{
  "name": "signal-session",
  "displayName": "Signal session",
  "version": "0.1.0",
  "description": "Keep working with a Claude Code session from your phone over Signal: each session gets its own Signal group with a bot number you own.",
  "author": {
    "name": "Phil Roche"
  },
  "homepage": "https://github.com/philroche/claude-signal-session",
  "repository": "https://github.com/philroche/claude-signal-session",
  "license": "MIT",
  "keywords": [
    "signal",
    "phone",
    "remote",
    "channel",
    "signal-cli"
  ],
  "mcpServers": {
    "signal": {
      "command": "python3",
      "args": [
        "-I",
        "${CLAUDE_PLUGIN_ROOT}/scripts/signal-channel.py"
      ]
    }
  },
  "channels": [
    {
      "server": "signal",
      "displayName": "Signal"
    }
  ]
}
